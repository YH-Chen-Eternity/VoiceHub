# ============================================================
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，禁止提交。
# ============================================================

# 阿里云 RAM 用户凭证（必填，缺失时服务以 DEGRADED 模式启动）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 运行环境：production / test
APP_ENV=production
LOG_LEVEL=INFO

# Endpoint 候选（默认上海优先、新加坡备选）
# MODERATION_ENDPOINTS=green-cip.cn-shanghai.aliyuncs.com=cn-shanghai,green-cip.ap-southeast-1.aliyuncs.com=ap-southeast-1

# 审核智能体 AppID（在阿里云内容安全控制台创建）
MODERATION_MULTIMODAL_APP_ID=img_txt_check_agent_01
MODERATION_IMAGE_APP_ID=img_check_agent_01

# 限流与队列
MODERATION_QPS_LIMIT=10
MODERATION_QUEUE_CAPACITY=1000
MODERATION_QUEUE_MAX_WAIT_SECONDS=120
MODERATION_TASK_TIMEOUT_SECONDS=15
MODERATION_AUDIT_TIMEOUT_SECONDS=18

# 可选：标准审核兜底（广告/敏感检测），会产生额外 API 调用
MODERATION_STANDARD_CHECK_ENABLED=false
MODERATION_STANDARD_TEXT_SERVICE=comment_detection_pro
MODERATION_STANDARD_IMAGE_SERVICE=baselineCheck

# 可选：DEGRADED 告警 webhook
MODERATION_WEBHOOK_URL=
